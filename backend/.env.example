PORT=3006

# Pre-filled in the "new machine" form. Any reachable broker works:
#   mqtt://localhost:1883        local Mosquitto / EMQX
#   mqtt://broker.emqx.io:1883   public test broker
#   ws://localhost:8083/mqtt     websocket listener
MQTT_DEFAULT_URL=mqtt://broker.emqx.io:1883

# Where machine definitions are stored (defaults to ./data/machines.json)
# DATA_FILE=

# Where the project workspaces are stored (defaults to ./data/workspaces.json)
# WORKSPACES_FILE=
